# Copy this file to .env and fill in values as needed. python-dotenv loads
# .env automatically on startup — nothing else to configure.

# Optional: a Groq API key configured here means end users don't have to
# paste their own key into the browser (handy for a shared/team deployment).
# Leave blank to require each user to supply their own key.
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=

# Port the server listens on.
PORT=5000

# Set to "false" in any real deployment — "true" enables Flask's interactive
# debugger and auto-reload, which must never be exposed outside local dev.
FLASK_DEBUG=true
